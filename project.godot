; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Project Pixel Tactics"
config/description="2D Pixel Turn-Based Strategy RPG - Tam Quoc Theme"
run/main_scene="res://scenes/battle/BattleScene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.png"

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
HeroDatabase="*res://scripts/data/HeroDatabase.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
