; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Pixel Tactics"
config/description="2D Pixel Turn-Based Strategy RPG - Tam Quoc Theme"
run/main_scene="res://scenes/battle/BattleScene.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://assets/common/icons/icon.png"

[autoload]

GameManager="*res://src/Autoload/GameManager.cs"
HeroDatabase="*res://src/Data/HeroDatabase.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="tamquoc3d"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
