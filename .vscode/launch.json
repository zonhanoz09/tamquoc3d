{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play Main Scene (Godot)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "godot",
      "args": ["--path", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false
    },
    {
      "name": "Play Current Scene (Godot)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "godot",
      "args": ["--path", "${workspaceFolder}", "${file}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false
    }
  ]
}